PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/brightloop_odoo
JWT_SECRET=replace-with-a-long-random-secret
APP_URL=http://localhost:5173
# Optional first admin; if set, both values are required and the password is hashed.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# In production set RESET_EMAIL_WEBHOOK to the team's trusted email delivery endpoint.
RESET_EMAIL_WEBHOOK=
