{
  "name": "brightloop-backend",
  "version": "1.0.0",
  "description": "Brightloop Subscription System Backend - Odoo x Make-A-Ton 2026",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node ../seed.js",
    "test": "jest --runInBand",
    "test:unit": "jest tests/invoiceFinancialMath.test.js",
    "test:integration": "jest tests/customerInvoiceAccess.integration.test.js",
    "test:all": "jest --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "tests/subscriptionStateMachineAndQuoteTemplate.test.js",
      "tests/invoiceDiscountRules.test.js"
    ]
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "nodemailer": "^6.9.15"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0"
  }
}
